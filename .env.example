# Copy to .env. Never commit .env.

# mock (offline, deterministic) | gemini
LLM_PROVIDER=mock
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# SQLite by default; Postgres example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/investigator
DATABASE_URL=sqlite:///./investigator.db

# Agent budget
MAX_STEPS=12
MAX_REVISIONS=1

# Price used for the cost column (USD per 1M tokens). Estimates; check your plan.
LLM_INPUT_PRICE_PER_MTOK=0.30
LLM_OUTPUT_PRICE_PER_MTOK=2.50
